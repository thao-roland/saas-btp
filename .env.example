# ============================================================
# Devisly — Variables d'environnement
# Copiez ce fichier en `.env` et renseignez vos vraies clés.
# Le détail pas-à-pas se trouve dans SETUP.md
# ============================================================

# ----- SUPABASE (projet) -----
# Tableau de bord Supabase > Project Settings > API
SUPABASE_URL=https://VOTRE-REF-PROJET.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...        # clé "anon public" — utilisée par le navigateur
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi... # clé "service_role" — SECRÈTE, jamais côté client

# ----- STRIPE (clés API) -----
# Tableau de bord Stripe > Developers > API keys
STRIPE_SECRET_KEY=sk_test_...           # clé secrète — SECRÈTE
STRIPE_PUBLISHABLE_KEY=pk_test_...      # clé publiable (facultatif côté client)

# Stripe > Developers > Webhooks > (votre endpoint) > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ----- STRIPE (identifiants de prix) -----
# Stripe > Product catalog : créez 1 produit "Pro" et 1 produit "Entreprise",
# chacun avec un tarif mensuel ET un tarif annuel. Copiez les "Price ID" (price_...).
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_ENTREPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTREPRISE_YEARLY=price_...

# ----- APPLICATION -----
# URL publique de l'application (sert aux redirections Checkout / Portail)
APP_URL=http://localhost:4173/index.html

# ------------------------------------------------------------
# Où vont ces variables :
#  - SUPABASE_URL + SUPABASE_ANON_KEY        -> js/config.js (navigateur)
#  - SUPABASE_SERVICE_ROLE_KEY, STRIPE_*,
#    APP_URL                                 -> Secrets des Edge Functions
#                                               (supabase secrets set ...)
# Ne committez JAMAIS votre fichier `.env` rempli.
# ------------------------------------------------------------
